{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./lib",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "target": "es2023",
    "module": "commonjs",
    "declaration": true,
    "sourceMap": true,
    "pretty": true,
    "importHelpers": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true
  },
  "exclude": ["node_modules"],
  "include": ["lib/**/*"]
}
