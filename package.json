{
  "name": "@snyk/go-semver",
  "description": "node-semver compatible API with Go modules dependencies semantics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/snyk/go-semver#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/snyk/go-semver.git"
  },
  "bugs": {
    "url": "https://github.com/snyk/go-semver/issues"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "build-dev": "tsc -w",
    "format": "prettier --write '{lib,test}/**/*.?s'",
    "lint:eslint": "eslint lib test",
    "lint:prettier": "prettier --check '{lib,test}/**/*.ts'",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "test": "jest --verbose --runInBand",
    "test:coverage": "npm run test -- --coverage",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "lib/go/LICENSE"
  ],
  "author": "Snyk <https://snyk.io>",
  "license": "Apache-2.0",
  "dependencies": {
    "tslib": "^2"
  },
  "overrides": {
    "test-exclude": "^7.0.1",
    "glob": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.0.0"
  }
}
